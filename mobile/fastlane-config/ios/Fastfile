default_platform(:ios)

require "shellwords"
require "fileutils"

platform :ios do
  private_lane :asc_api_key do
    key_id = ENV["APP_STORE_KEY_ID"]
    issuer_id = ENV["APP_STORE_ISSUER_ID"]
    key_filepath = ENV["APP_STORE_KEY_FILEPATH"]
    key_content = ENV["APP_STORE_KEY"] || ENV["APP_STORE_KEY_CONTENT"]

    UI.user_error!("Set APP_STORE_KEY_ID") if key_id.to_s.empty?
    UI.user_error!("Set APP_STORE_ISSUER_ID") if issuer_id.to_s.empty?
    UI.user_error!("Set APP_STORE_KEY_FILEPATH or APP_STORE_KEY") if key_filepath.to_s.empty? && key_content.to_s.empty?

    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_filepath,
      key_content: key_content,
      is_key_content_base64: ENV["APP_STORE_IS_BASE64"] == "1"
    )
  end

  desc "Build and upload an IPA to App Store Connect"
  lane :upload_ipa do |options|
    api_key = asc_api_key
    app_identifier = options[:app_identifier] || ENV["IOS_APP_IDENTIFIER"] || "jp.nonbili.meron"
    ipa_path = options[:ipa] || ENV["IPA_PATH"] || File.expand_path("../../ios/build/Meron.ipa", __dir__)
    project_path = ENV["IOS_PROJECT"] || File.expand_path("../../ios/Meron.xcodeproj", __dir__)
    build_before_upload = ENV["IOS_BUILD_BEFORE_UPLOAD"] == "1"
    skip_binary_upload = ENV["IOS_SKIP_BINARY_UPLOAD"] == "1"
    submit_for_review = ENV["IOS_SUBMIT_FOR_REVIEW"] == "1"
    app_version = ENV["IOS_APP_VERSION"]
    build_number = ENV["IOS_BUILD_NUMBER"]
    release_notes_path = ENV["IOS_RELEASE_NOTES_PATH"] || File.expand_path("../../fastlane/metadata/ios/en-US/release_notes.txt", __dir__)
    release_notes = File.exist?(release_notes_path) ? File.read(release_notes_path).strip : nil

    if build_before_upload
      team_id = ENV["APP_STORE_DEVELOPMENT_TEAM"].to_s
      allow_provisioning_updates = ENV["IOS_ALLOW_PROVISIONING_UPDATES"] != "0"
      derived_data_path = ENV["IOS_DERIVED_DATA_PATH"] || File.expand_path("../../ios/build/DerivedData/AppStoreArchive", __dir__)
      clean_derived_data = ENV["IOS_CLEAN_DERIVED_DATA"] != "0"
      xcodebuild_auth_args = []

      if allow_provisioning_updates
        xcodebuild_auth_args << "-allowProvisioningUpdates"
        if ENV["IOS_USE_API_KEY_FOR_SIGNING"] == "1" && !ENV["APP_STORE_KEY_FILEPATH"].to_s.empty?
          xcodebuild_auth_args << "-authenticationKeyPath #{Shellwords.escape(ENV['APP_STORE_KEY_FILEPATH'])}"
          xcodebuild_auth_args << "-authenticationKeyID #{Shellwords.escape(ENV['APP_STORE_KEY_ID'])}"
          xcodebuild_auth_args << "-authenticationKeyIssuerID #{Shellwords.escape(ENV['APP_STORE_ISSUER_ID'])}"
        end
      end

      build_xcargs = []
      build_xcargs << "DEVELOPMENT_TEAM=#{team_id}" if !team_id.empty?
      build_xcargs.concat(xcodebuild_auth_args)

      if clean_derived_data
        FileUtils.rm_rf(derived_data_path)
      end

      build_app(
        project: project_path,
        scheme: ENV["IOS_SCHEME"] || "Meron",
        configuration: ENV["IOS_CONFIGURATION"] || "Release",
        export_method: ENV["IOS_EXPORT_METHOD"] || "app-store",
        export_team_id: team_id.empty? ? nil : team_id,
        output_directory: File.dirname(ipa_path),
        output_name: File.basename(ipa_path),
        derived_data_path: derived_data_path,
        clean: true,
        xcargs: build_xcargs.empty? ? nil : build_xcargs.join(" ")
      )
    end

    UI.user_error!("IPA not found: #{ipa_path}") if !skip_binary_upload && !File.exist?(ipa_path)

    # App Info is shared with macOS and may be locked by its review. Release
    # notes and release type belong to the iOS version and remain editable.
    app = Spaceship::ConnectAPI::App.find(app_identifier)
    UI.user_error!("App not found: #{app_identifier}") unless app
    platform = Spaceship::ConnectAPI::Platform::IOS
    if ENV["IOS_REJECT_IF_POSSIBLE"] == "1"
      submission = app.get_in_progress_review_submission(platform: platform)
      submission.cancel_submission if submission
      # Both records must leave review before we can edit and resubmit.
      21.times do |attempt|
        submission = app.get_in_progress_review_submission(platform: platform)
        reviewing_versions = app.get_app_store_versions(filter: {
          platform: platform,
          appVersionState: "IN_REVIEW,WAITING_FOR_REVIEW,READY_FOR_REVIEW"
        })
        break if submission.nil? && reviewing_versions.empty?
        UI.user_error!("iOS version is still in review after cancellation; retry once it becomes editable") if attempt == 20
        UI.message("Waiting for iOS version to leave review...")
        sleep(15)
      end
    end
    app.ensure_version!(app_version, platform: platform) unless app_version.to_s.empty?
    version = nil
    21.times do |attempt|
      version = app.get_edit_app_store_version(platform: platform)
      break if version && (app_version.to_s.empty? || version.version_string == app_version)
      break if attempt == 20
      UI.message("Waiting for editable iOS version #{app_version} to appear...")
      sleep(15)
    end
    UI.user_error!("No editable iOS version for #{app_identifier}") unless version
    if !app_version.to_s.empty? && version.version_string != app_version
      UI.user_error!("Expected iOS version #{app_version}, found #{version.version_string}")
    end

    version.update(attributes: { releaseType: ENV["IOS_AUTOMATIC_RELEASE"] == "1" ? "AFTER_APPROVAL" : "MANUAL" })
    # App Store Connect does not accept What's New on the first iOS version.
    first_version = app.get_app_store_versions(filter: { platform: platform }, limit: 2).count == 1
    if !release_notes.to_s.empty? && !first_version
      localization = version.get_app_store_version_localizations.find { |item| item.locale == "en-US" }
      if localization
        localization.update(attributes: { whats_new: release_notes })
      else
        version.create_app_store_version_localization(attributes: { locale: "en-US", whatsNew: release_notes })
      end
      UI.success("Updated iOS #{version.version_string} release notes (en-US)")
    end

    upload_options = {
      force: true,
      api_key: api_key,
      app_identifier: app_identifier,
      app_version: app_version,
      metadata_path: File.expand_path("../../fastlane/metadata/ios", __dir__),
      screenshots_path: File.expand_path("../../fastlane/metadata/ios", __dir__),
      skip_metadata: true,
      skip_binary_upload: skip_binary_upload,
      skip_screenshots: true,
      ignore_language_directory_validation: true,
      run_precheck_before_submit: false,
      reject_if_possible: ENV["IOS_REJECT_IF_POSSIBLE"] == "1",
      submit_for_review: submit_for_review,
      automatic_release: ENV["IOS_AUTOMATIC_RELEASE"] == "1",
      submission_information: {
        add_id_info_uses_idfa: ENV["IOS_USES_IDFA"] == "1",
        export_compliance_uses_encryption: ENV["IOS_USES_ENCRYPTION"] == "1",
        export_compliance_encryption_updated: false
      }
    }

    if skip_binary_upload
      upload_options[:build_number] = build_number
    else
      upload_options[:ipa] = ipa_path
    end

    upload_to_app_store(upload_options)
  end

  desc "Upload framed screenshots to App Store Connect"
  lane :upload_screenshots do
    api_key = asc_api_key
    upload_to_app_store(
      api_key: api_key,
      app_identifier: ENV["IOS_APP_IDENTIFIER"] || "jp.nonbili.meron",
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      screenshots_path: File.expand_path("../../fastlane/metadata/ios", __dir__),
      overwrite_screenshots: true,
      run_precheck_before_submit: false
    )
  end
end
