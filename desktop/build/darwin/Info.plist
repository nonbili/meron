<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>CFBundlePackageType</key>
        <string>APPL</string>
        <key>CFBundleName</key>
        <string>{{.Info.ProductName}}</string>
        <key>CFBundleExecutable</key>
        <string>{{.OutputFilename}}</string>
        <key>CFBundleIdentifier</key>
        <string>jp.nonbili.{{.Name}}</string>
        <!-- The build number, independent of the marketing version below the way
             CURRENT_PROJECT_VERSION is of MARKETING_VERSION on iOS. App Store
             Connect dedupes uploads on it, so bump it for every upload, including
             a re-upload of a version already there. It does not live in
             wails.json: the wails CLI rewrites that file from a Go struct with no
             field for it (`wails dev`), which would drop it without a word. -->
        <key>CFBundleVersion</key>
        <string>35</string>
        <key>CFBundleGetInfoString</key>
        <string>{{.Info.Comments}}</string>
        <key>CFBundleShortVersionString</key>
        <string>{{.Info.ProductVersion}}</string>
        <key>CFBundleIconFile</key>
        <string>iconfile</string>
        <key>LSMinimumSystemVersion</key>
        <string>10.13.0</string>
        <key>NSHighResolutionCapable</key>
        <string>true</string>
        <key>NSHumanReadableCopyright</key>
        <string>{{.Info.Copyright}}</string>
        <!-- Required by the App Store; harmless for the DMG build, where it just
             sets the Finder category. -->
        <key>LSApplicationCategoryType</key>
        <string>public.app-category.productivity</string>
        <!-- The app's only cryptography is TLS and the SQLCipher local store,
             both exempt under category 5D992, so App Store Connect can skip the
             export-compliance prompt on every upload. Matches the iOS answer in
             fastlane-config/ios/Fastfile. -->
        <key>ITSAppUsesNonExemptEncryption</key>
        <false/>
        <key>CFBundleDocumentTypes</key>
        <array>
          <dict>
            <key>CFBundleTypeName</key><string>Email message</string>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <key>LSHandlerRank</key><string>Alternate</string>
            <key>LSItemContentTypes</key><array><string>com.apple.mail.email</string></array>
            <key>CFBundleTypeExtensions</key><array><string>eml</string></array>
          </dict>
        </array>
        {{if .Info.Protocols}}
        <key>CFBundleURLTypes</key>
        <array>
          {{range .Info.Protocols}}
            <dict>
                <key>CFBundleURLName</key>
                <string>jp.nonbili.{{.Scheme}}</string>
                <key>CFBundleURLSchemes</key>
                <array>
                    <string>{{.Scheme}}</string>
                </array>
                <key>CFBundleTypeRole</key>
                <string>{{.Role}}</string>
            </dict>
          {{end}}
        </array>
        {{end}}
    </dict>
</plist>
