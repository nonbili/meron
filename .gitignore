# Wails build outputs and generated frontend bindings.
/desktop/build/bin/
# Sidecar staged for embedding by scripts/build.sh.
/desktop/build/sidecar/
# Defaults Wails regenerates on every Windows build (icon from
# desktop/build/appicon.png, info.json from desktop/wails.json). Not
# desktop/build/windows itself: appx/ is hand-maintained.
/desktop/build/windows/icon.ico
/desktop/build/windows/info.json
/desktop/build/windows/wails.exe.manifest
/desktop/frontend/wailsjs/
/desktop/frontend/package.json.md5

# Generated localization artifacts (source of truth: locales/*.json, see scripts/i18n/catalog.ts).
/desktop/frontend/src/generated/locales.ts
/mobile/android/src/main/res/values/strings.xml
/mobile/android/src/main/res/values-*/strings.xml
/mobile/android/src/main/java/jp/nonbili/meron/GeneratedIcuStrings.kt
/mobile/ios/Meron/Localizable.xcstrings
/mobile/ui/src/commonMain/kotlin/jp/nonbili/meron/ui/GeneratedStrings.kt

# Local binaries produced by ad-hoc `go build`.
/meron
/desktop/meron

# Release workflow staging/outputs.
/snap/local/
/dist/
/*.snap
/*.AppImage

# Dependencies and build caches.
/desktop/frontend/node_modules/
/desktop/frontend/dist/
/node_modules/
/meron-core/target/

# Local environment.
/.env.local

# macOS Finder metadata.
.DS_Store

# AI assistant workspace files.
/.antigravitycli/
/.claude/
/AGENTS.md
/CLAUDE.md
